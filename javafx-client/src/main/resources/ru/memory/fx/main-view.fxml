                                                    <children><Label text="Каталог услуг" styleClass="section-title" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="serviceCountLabel" text="Показано: 0" styleClass="result-count" /></children>
                                                </HBox>
                                                <TableView fx:id="servicesTable" fixedCellSize="58.0" VBox.vgrow="ALWAYS">
                                                    <placeholder>
                                                        <VBox alignment="CENTER" spacing="8.0" styleClass="empty-table">
                                                            <children><Label text="Услуг пока нет" styleClass="empty-title" /><Label text="Добавьте первую услугу в каталог." styleClass="empty-copy" /></children>
                                                        </VBox>
                                                    </placeholder>
                                                    <columns>
                                                        <TableColumn fx:id="serviceNameColumn" minWidth="320.0" prefWidth="520.0" text="Название" />
                                                        <TableColumn fx:id="servicePriceColumn" minWidth="160.0" prefWidth="220.0" text="Цена" />
                                                        <TableColumn fx:id="serviceUsageColumn" minWidth="160.0" prefWidth="220.0" text="В заказах" />
                                                    </columns>
                                                </TableView>
                                                <HBox alignment="CENTER_RIGHT" spacing="10.0" styleClass="table-actions">
                                                    <children><Button fx:id="serviceDeleteButton" onAction="#deleteSelectedService" text="Удалить услугу" styleClass="button-danger-quiet" /></children>
                                                </HBox>
                                            </children>
                                        </VBox>
                                    </children>
                                </VBox>

                                <VBox fx:id="statisticsRoot" spacing="20.0" styleClass="content-root" visible="false" managed="false">
                                    <padding><Insets bottom="24.0" left="28.0" right="28.0" top="26.0" /></padding>
                                    <children>
                                        <HBox alignment="CENTER_LEFT" spacing="16.0" styleClass="page-header">
                                            <children>
                                                <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                    <children>
                                                        <Label text="Аналитика заказов" styleClass="page-title" />
                                                        <Label text="Статусы, суммы и общие показатели заказов" styleClass="page-subtitle" />
                                                    </children>
                                                </VBox>
                                                <Button fx:id="statsRefreshButton" onAction="#refreshOrders" text="Обновить данные" styleClass="button-secondary" />
                                                <Button onAction="#showOrdersPage" text="Вернуться к заказам" styleClass="button-primary" />
                                            </children>
                                        </HBox>

                                        <VBox spacing="16.0" styleClass="period-panel">
                                            <children>
                                                <HBox alignment="CENTER_LEFT" spacing="12.0">
                                                    <children>
                                                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                                                            <children>
                                                                <Label text="Статистика за период" styleClass="section-title" />
                                                                <Label fx:id="statsPeriodCaption" text="Выберите даты" styleClass="empty-copy" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </HBox>

                                                <HBox alignment="BOTTOM_LEFT" spacing="12.0" styleClass="period-controls">
                                                    <children>
                                                        <VBox spacing="6.0">
                                                            <children>
                                                                <Label text="Дата начала" styleClass="period-field-label" />
                                                                <DatePicker fx:id="statsFromDate" prefWidth="190.0" promptText="дд.мм.гггг" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="6.0">
                                                            <children>
                                                                <Label text="Дата окончания" styleClass="period-field-label" />
                                                                <DatePicker fx:id="statsToDate" prefWidth="190.0" promptText="дд.мм.гггг" />
                                                            </children>
                                                        </VBox>
                                                        <Button fx:id="statsApplyPeriodButton" onAction="#applyPeriodStatistics" text="Показать статистику" styleClass="button-primary" />
                                                    </children>
                                                </HBox>

                                                <Label fx:id="statsPeriodError" text="Проверьте выбранный период" wrapText="true" visible="false" managed="false" styleClass="form-error" />

                                                <GridPane hgap="0.0" styleClass="period-metrics">
                                                    <columnConstraints>
                                                        <ColumnConstraints percentWidth="25.0" />
                                                        <ColumnConstraints percentWidth="25.0" />
                                                        <ColumnConstraints percentWidth="25.0" />
                                                        <ColumnConstraints percentWidth="25.0" />
                                                    </columnConstraints>
                                                    <children>
                                                        <VBox spacing="6.0" styleClass="period-metric" GridPane.columnIndex="0">
                                                            <children><Label text="Количество заказов" styleClass="metric-label" /><Label fx:id="statsPeriodOrderCountLabel" text="0 заказов" styleClass="period-metric-value" /></children>
                                                        </VBox>
                                                        <VBox spacing="6.0" styleClass="period-metric" GridPane.columnIndex="1">
                                                            <children><Label text="Минимальная сумма" styleClass="metric-label" /><Label fx:id="statsPeriodMinLabel" text="0 ₽" styleClass="period-metric-value" /></children>
                                                        </VBox>
                                                        <VBox spacing="6.0" styleClass="period-metric" GridPane.columnIndex="2">
                                                            <children><Label text="Максимальная сумма" styleClass="metric-label" /><Label fx:id="statsPeriodMaxLabel" text="0 ₽" styleClass="period-metric-value" /></children>
                                                        </VBox>
                                                        <VBox spacing="6.0" styleClass="period-metric-last" GridPane.columnIndex="3">
                                                            <children><Label text="Выручка завершённых" styleClass="metric-label" /><Label fx:id="statsPeriodRevenueLabel" text="0 ₽" styleClass="period-metric-value-accent" /></children>
                                                        </VBox>
                                                    </children>
                                                </GridPane>
                                            </children>
                                        </VBox>

                                        <GridPane hgap="16.0" vgap="16.0" VBox.vgrow="ALWAYS">
                                            <columnConstraints>
                                                <ColumnConstraints percentWidth="56.0" />
                                                <ColumnConstraints percentWidth="44.0" />
                                            </columnConstraints>
                                            <children>
                                                <VBox spacing="18.0" styleClass="statistics-panel" GridPane.columnIndex="0">
                                                    <children>
                                                        <HBox alignment="TOP_LEFT" spacing="12.0">
                                                            <children>
                                                                <VBox spacing="4.0">
                                                                    <children>
                                                                        <Label text="Распределение по статусам" styleClass="section-title" />
                                                                        <Label text="Доля каждого статуса в общем количестве заказов" styleClass="empty-copy" />
                                                                    </children>
                                                                </VBox>
                                                                <Region HBox.hgrow="ALWAYS" />
                                                                <Label fx:id="statsTotalOrdersLabel" text="0 заказов" styleClass="stat-value" />
                                                            </children>
                                                        </HBox>
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <HBox spacing="12.0"><Label text="Новые" styleClass="stat-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="statsNewCountLabel" text="0" styleClass="stat-value" /></HBox>
                                                                <ProgressBar fx:id="statsNewProgress" maxWidth="1.7976931348623157E308" progress="0" styleClass="stat-progress, progress-new" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <HBox spacing="12.0"><Label text="В обработке" styleClass="stat-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="statsProgressCountLabel" text="0" styleClass="stat-value" /></HBox>
                                                                <ProgressBar fx:id="statsProgressProgress" maxWidth="1.7976931348623157E308" progress="0" styleClass="stat-progress, progress-active" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <HBox spacing="12.0"><Label text="Выполненные" styleClass="stat-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="statsCompletedCountLabel" text="0" styleClass="stat-value" /></HBox>
                                                                <ProgressBar fx:id="statsCompletedProgress" maxWidth="1.7976931348623157E308" progress="0" styleClass="stat-progress, progress-completed" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="7.0">
                                                            <children>
                                                                <HBox spacing="12.0"><Label text="Отменённые" styleClass="stat-label" /><Region HBox.hgrow="ALWAYS" /><Label fx:id="statsCancelledCountLabel" text="0" styleClass="stat-value" /></HBox>
                                                                <ProgressBar fx:id="statsCancelledProgress" maxWidth="1.7976931348623157E308" progress="0" styleClass="stat-progress, progress-cancelled" />
                                                            </children>
                                                        </VBox>
                                                    </children>
                                                </VBox>

                                                <VBox spacing="20.0" styleClass="statistics-panel" GridPane.columnIndex="1">
                                                    <children>
                                                        <VBox spacing="4.0">
                                                            <children>
                                                                <Label text="Финансовая сводка" styleClass="section-title" />
                                                                <Label text="Суммы рассчитаны по загруженным заказам" styleClass="empty-copy" />
                                                            </children>
                                                        </VBox>
                                                        <VBox spacing="6.0" styleClass="stat-finance-row">
                                                            <children>
                                                                <Label text="Общая стоимость" styleClass="metric-label" />
                                                                <Label fx:id="statsPortfolioSumLabel" text="0 ₽" styleClass="stat-finance-value" />
                                                            </children>
                                                        </VBox>
                                                        <Separator />
                                                        <VBox spacing="6.0" styleClass="stat-finance-row">
                                                            <children>
                                                                <Label text="Средний заказ" styleClass="metric-label" />
                                                                <Label fx:id="statsAverageOrderLabel" text="0 ₽" styleClass="stat-finance-value" />
                                                            </children>
                                                        </VBox>
                                                        <Separator />
                                                        <VBox spacing="6.0" styleClass="stat-finance-row">
                                                            <children>
                                                                <Label text="Сумма активных заказов" styleClass="metric-label" />
                                                                <Label fx:id="statsActiveSumLabel" text="0 ₽" styleClass="stat-finance-value" />
                                                            </children>
                                                        </VBox>
                                                        <Region VBox.vgrow="ALWAYS" />
                                                        <Label text="Сводка обновляется после создания, редактирования, удаления или ручного обновления данных." wrapText="true" styleClass="empty-copy" />
                                                    </children>
                                                </VBox>
                                            </children>
                                        </GridPane>
                                    </children>
                                </VBox>
                            </children>
                        </StackPane>
                    </content>
                </ScrollPane>
            </center>
        </BorderPane>

        <StackPane alignment="BOTTOM_CENTER" mouseTransparent="true">
            <padding><Insets bottom="24.0" /></padding>
            <children><Label fx:id="toastLabel" text="Данные обновлены" visible="false" managed="false" styleClass="toast" /></children>
        </StackPane>
    </children>
</StackPane>
